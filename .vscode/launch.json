{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Native: Example 01 (Triangle)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/native/01_triangle",
            "windows": {
                "program": "${workspaceFolder}/bin/native/01_triangle.exe"
            },
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Build All Native Examples",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
